<nav class="main-navigation" aria-label="Main navigation">
  <ul>
    <li><a href="index.html">Home</a></li>
    <li><a href="html.html">HTML Roadmap</a></li>
    <li><a href="css.html">CSS Roadmap</a></li>
    <li><a href="index.html#about">About</a></li>
    <li><a href="index.html#contact">Contact</a></li>
  </ul>
</nav>
<nav class="module-navigation" aria-label="Course modules">
  <div class="menu-search">
    <label class="visually-hidden" for="menu-search">Filter modules and sections</label>
    <input type="search" id="menu-search" class="menu-search-input" placeholder="Filter modules &amp; sections…" autocomplete="off" aria-describedby="menu-search-status">
    <p class="menu-search-status" id="menu-search-status" role="status"></p>
  </div>
  <ul class="module-nav-list">
    {%- for m in modules -%}
    <li class="module-group">
      <a href="#{{ m.id }}">{{ m.label }}</a>
      <aside class="submodule-aside" aria-label="{{ m.label }} submodules">
        <ul>
          {%- for s in m.sections -%}
          <li><a href="#{{ s.id }}">{{ s.title | safe }}</a></li>
          {%- endfor -%}
        </ul>
      </aside>
    </li>
    {%- endfor -%}
  </ul>
  <p class="nav-crosslink">
    Also on this site:
    <a href="{{ otherPage.href }}">{{ otherPage.text }}</a>
  </p>
</nav>
